{
  "cli": {
    "version": ">= 14.1.3"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_OPENCLAW_ENABLE_MOCK_MODE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_OPENCLAW_ENABLE_MOCK_MODE": "false"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_OPENCLAW_ENABLE_MOCK_MODE": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
