# Default OpenClaw Gateway URL used to prefill manual connection.
EXPO_PUBLIC_OPENCLAW_DEFAULT_GATEWAY_URL=http://openclaw.local:3333

# Keep true while testing without a live OpenClaw Gateway.
EXPO_PUBLIC_OPENCLAW_ENABLE_MOCK_MODE=true

# Voice transport for real Gateway sessions:
# - "openai-realtime" (recommended): Direct WebRTC to OpenAI Realtime API (~200-300ms latency)
# - "livekit": Low-latency LiveKit room session brokered by your Gateway
# - "legacy": Traditional STT -> text -> TTS flow
# All realtime options require a native dev build (not Expo Go).
EXPO_PUBLIC_OPENCLAW_VOICE_TRANSPORT=openai-realtime

# "auto" tries the native Expo speech recognition module first and falls back to mock mode.
# Only used when VOICE_TRANSPORT is "legacy".
EXPO_PUBLIC_OPENCLAW_STT_PROVIDER=auto

# Default TTS provider. "expo" uses expo-speech.
# Only used when VOICE_TRANSPORT is "legacy".
EXPO_PUBLIC_OPENCLAW_TTS_PROVIDER=expo

# OpenAI Realtime 2.0 API settings (required when VOICE_TRANSPORT is "openai-realtime")
# Get your API key from https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI Realtime 2.0 model (GA release)
EXPO_PUBLIC_OPENAI_REALTIME_MODEL=gpt-realtime-2

# OpenAI Realtime 2.0 voice options:
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
EXPO_PUBLIC_OPENAI_REALTIME_VOICE=marin

# Reasoning effort for Realtime 2.0
# - "low": Fastest response, recommended for most voice agents
# - "medium": Balanced reasoning and latency
# - "high": Most thorough reasoning, higher latency
EXPO_PUBLIC_OPENAI_REALTIME_REASONING_EFFORT=low
